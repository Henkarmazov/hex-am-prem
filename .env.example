# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# UPSTREAM_API_URL: Optional custom upstream backend URL (defaults to https://amvercel.vercel.app).
UPSTREAM_API_URL="https://amvercel.vercel.app"

# API_SECRET_KEY: Optional secret key / bearer token for upstream authentication.
API_SECRET_KEY=""
